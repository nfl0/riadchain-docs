{
  "name": "@riadchain/docs",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build && node scripts/verify-build.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "verify": "bun run build && wrangler deploy --dry-run",
    "deploy": "bun run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.0",
    "@astrojs/starlight": "0.42.5",
    "astro": "7.3.5"
  },
  "overrides": {
    "vite": "8.3.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "parse5": "8.0.0",
    "wrangler": "4.129.0"
  },
  "description": "Public documentation for Riadchain nodes, contracts, SDKs and applications.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nfl0/riadchain-docs.git"
  },
  "homepage": "https://docs.riadchain.com",
  "bugs": {
    "url": "https://github.com/nfl0/riadchain-docs/issues"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "bun@1.3.11"
}
