{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "riadchain-docs",
  "compatibility_date": "2026-10-03",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "docs.riadchain.com", "custom_domain": true }],
  // Assets-only: no Worker entry point, SSR, storage bindings or paid services.
  "assets": {
    "directory": "./dist",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  }
}
